# Pipeline de ingesta y análisis. Copiar a .env (nunca commitear .env con valores reales).
# Proyecto Supabase "escucha-comunitaria" (ver documentacion/infraestructura).

SUPABASE_URL=https://wnqwuamyqjllkbkjmssy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service role key desde Supabase Dashboard>

# Embeddings: recomendacion de trabajo Voyage voyage-4 (ver decision_embeddings_y_bertopic.md).
# Pendiente de verificar con habla costena real antes de dar DIM por definitivo (requerimientos_v3 §5.3).
VOYAGE_API_KEY=<voyage api key>
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIM=1024

# LLM primario: local en equipo dedicado, accedido por VPN/Tailscale (OpenAI-compatible).
LLM_LOCAL_ENDPOINT=<endpoint del LLM local, ej. http://localhost:1234/v1>
LLM_LOCAL_MODEL=google/gemma-4-12b-qat

# LLM fallback: API de Anthropic (Claude Haiku), si el LLM local no responde.
ANTHROPIC_API_KEY=<anthropic api key>
ANTHROPIC_FALLBACK_MODEL=claude-haiku-4-5